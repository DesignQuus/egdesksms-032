# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env* 는 git에 올라가지 않습니다 — 이 예시 파일만 예외)

# EGDesk 연결 정보 (EGDesk에서 실행 시 자동 주입됨)
NEXT_PUBLIC_EGDESK_API_URL=http://localhost:8080
NEXT_PUBLIC_EGDESK_API_KEY=
# [필수] 이지데스크 My DB 프로젝트 ID. 없으면 서버가 시작하지 않음(다른 프로젝트 DB 보호).
# 확인: 이지데스크 실행 중 PowerShell 에서 user_data_list_projects 조회 → 이 프로젝트 name 의 projectId
NEXT_PUBLIC_EGDESK_PROJECT_ID=
# [선택] development/production. 비우면 next dev=development, next start=production
NEXT_PUBLIC_EGDESK_ENV=
# [선택] 서버 전용 내부 주소(지정 시 위 API_URL 보다 우선)
EGDESK_MCP_INTERNAL_URL=

# (사용 안 함) 예전 JWT 로그인용 키. 로그인은 이제 이지데스크 My DB 서버 세션(crm_user_sessions)을 쓴다.
JWT_SECRET=

# [선택] 상태를 바꾸는 요청을 허용할 추가 출처(쉼표 구분, 예: https://example.com). 이 서버·이지데스크 터널 주소는 자동 허용
APP_ORIGINS=

# 서버 간 호출(네이버 블로그 RPA 데몬 등) 인증 토큰 (16자 이상)
INTERNAL_API_TOKEN=

# 최초 관리자 비밀번호 (비워두면 /api/setup-admin 접속 시 무작위 생성 후 1회 표시)
ADMIN_INITIAL_PASSWORD=

# 개발 모드에서만 DB 전체 초기화(/api/reset-all) 허용 — 평소에는 false 유지
ENABLE_DANGEROUS_ROUTES=false
